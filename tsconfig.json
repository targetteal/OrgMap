{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "packages/contracts/**/*.ts",
    "tests/server/**/*.ts",
    "scripts/**/*.ts",
    "ops/docker/**/*.ts"
  ]
}
