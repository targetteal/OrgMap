{
  "name": "orgmap",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server/src/main.ts",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "npm run dev --workspace web",
    "dev:landing": "npm run dev --workspace web -- --port 5270",
    "brand:generate": "tsx scripts/generate-brand-assets.ts",
    "build": "tsc --noEmit && npm run build --workspace web",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx server/src/migrate.ts",
    "test": "tsx scripts/test-server.ts",
    "test:server": "tsx scripts/test-server.ts",
    "mail:deliver": "tsx server/src/mail-cli.ts",
    "typecheck:foundation": "tsc -p server/tsconfig.json",
    "test:foundation": "tsx scripts/test-server.ts --foundation",
    "smtp:dev": "tsx server/src/smtp-cli.ts",
    "mail:accounts": "tsx server/src/account-mail-cli.ts",
    "db:backup": "tsx scripts/backup.ts create",
    "db:restore-check": "tsx scripts/backup.ts verify",
    "platform:configure-dispatcher": "tsx scripts/configure-dispatcher.ts",
    "iam:mail": "tsx scripts/iam-mail.ts",
    "iam:configure-mail": "tsx scripts/iam-mail.ts --configure",
    "db:restore": "tsx scripts/backup.ts restore",
    "test:ops-backup": "tsx scripts/test-ops-backup.ts",
    "test:iam-mail-cli": "tsx scripts/test-iam-mail-cli.ts",
    "test:iam-mail": "tsx scripts/test-iam-mail.ts",
    "test:foundation-collective": "tsx scripts/test-foundation-collective.ts",
    "test:guest-core": "tsx scripts/test-guest-core.ts",
    "test:mfa": "tsx scripts/test-mfa.ts",
    "test:foundation-migrations": "tsx scripts/test-foundation-migrations.ts",
    "test:account-email": "tsx scripts/test-account-email.ts",
    "test:account-media": "tsx scripts/test-account-media.ts",
    "test:credential-policy": "tsx scripts/test-credential-policy.ts",
    "iam:configure-mfa": "tsx scripts/configure-mfa.ts",
    "test:admission-public": "tsx scripts/test-admission-public.ts",
    "test:admission-invitations": "tsx scripts/test-admission-invitations.ts",
    "test:admission-scim": "tsx scripts/test-admission-scim.ts",
    "test:admission-mail-cli": "tsx scripts/test-admission-mail-cli.ts",
    "dev:local": "tsx server/integration/local-dev.ts",
    "test:web": "npm test --workspace web"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/websocket": "11.3.4",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@node-saml/node-saml": "5.1.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "@zxcvbn-ts/language-pt-br": "4.1.1",
    "ajv": "8.20.0",
    "fastify": "^5.6.0",
    "fontkit": "2.0.4",
    "jose": "6.2.12",
    "pdfkit": "0.20.2",
    "pg": "^8.16.3",
    "sharp": "0.35.5",
    "tsx": "^4.20.5",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/jsdom": "27.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.15.5",
    "@types/ws": "8.18.2",
    "jsdom": "27.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "xml-crypto": "6.4.0"
  }
}
